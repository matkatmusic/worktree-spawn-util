{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Worktree: Pick Repository",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/dist/cli/pick-repo.js", "${input:worktreeName}"],
      // "args": ["${workspaceFolder}/dist/cli/pick-repo.js", "--inspectHB", "${input:worktreeName}"],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": [],
      "dependsOn": ["Build"]
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": ["$tsc"]
    }
  ],
  "inputs": [
    {
      "id": "worktreeName",
      "type": "promptString",
      "description": "Worktree name"
    }
  ]
}
